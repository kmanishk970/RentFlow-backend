# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL="postgresql://rentflow:rentflow@localhost:5432/rentflow?schema=public"

# Generated per environment — never commit a real one.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="30d"

# Object storage for documents and photos. Any S3-compatible host.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="rentflow"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

PORT=4000
CORS_ORIGIN="http://localhost:3000"
