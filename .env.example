# Copy to .env and set your own values. .env is git-ignored.

# Your local Postgres — the server registered under the Rent_Manager group in
# pgAdmin. Create the database first with
# src/database/sql/0000_create_database.sql, then set the password here.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/rent_manager"
DATABASE_LOGGING=false

# Generated per environment — never commit a real one. At least 16 characters.
JWT_SECRET="change-me-to-something-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too-and-differently"
JWT_REFRESH_EXPIRES_IN="30d"

# Cloudinary holds documents and photos. Leave blank to run without uploads;
# every other endpoint still works.
#
# Easiest: copy the "API environment variable" line from Console > Settings >
# API Keys, which carries all three values and cannot be mismatched.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
#
# Or set them separately — but take all three from the SAME product
# environment, or Cloudinary answers every upload with "cloud_name mismatch".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Root folder inside the account. Uploads land in <folder>/<owner-id>/<kind>.
CLOUDINARY_FOLDER="rentflow"

NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"
